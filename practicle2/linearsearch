#include <stdio.h>

int main()
{
    int n, i, num;

    printf("Enter the size of the array: ");
    scanf("%d", &n);

    int arr[n];

    printf("Enter the elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter the number to search: ");
    scanf("%d", &num);

    for(i = 0; i < n; i++)
    {
        if(arr[i] == num)
        {
            printf("Element found at index %d", i);
            return 0;
        }
    }

    printf("Element not found.");

    return 0;
}